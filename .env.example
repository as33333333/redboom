# Backend
APP_ENV=local
DATABASE_URL=sqlite:////app/site/backend/app.db

# Authorized Douyin data sidecar.
# Leave empty to use local mock data.
DOUYIN_API_BASE=http://douyin-api:80
DOUYIN_MIN_REQUEST_INTERVAL_SECONDS=2.0
DOUYIN_MAX_POSTS_PER_FETCH=10

# LLM analysis, optional. Leave empty to use mock analysis.
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
